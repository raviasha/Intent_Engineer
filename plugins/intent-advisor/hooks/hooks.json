{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/prompt-hook",
            "timeout": 15,
            "statusMessage": "Checking repository intent",
            "additionalContextLimit": 2048
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/stop-hook",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
